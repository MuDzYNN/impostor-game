# Copy to .env next to docker-compose.yml on the server

# ghcr.io/<owner>/<repo>, lowercase
IMAGE=ghcr.io/owner/impostor-game

# URL-safe, e.g. openssl rand -hex 32
POSTGRES_PASSWORD=

# At least 32 characters, e.g. openssl rand -base64 32
JWT_SECRET=

WEB_URL=https://impostor.mudzyn.xyz
API_URL=https://impostor-api.mudzyn.xyz

# Optional, a provider without keys is hidden on the login page
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Zero Trust > Networks > Tunnels > the tunnel's install command
TUNNEL_TOKEN=
