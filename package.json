{
	"name": "impostor-game",
	"private": true,
	"scripts": {
		"dev": "pnpm --filter @impostor/game build && pnpm -r --parallel dev",
		"build": "pnpm -r build",
		"db:up": "docker compose -f docker-compose.dev.yml up -d postgres",
		"db:migrate": "pnpm --filter api exec prisma migrate deploy",
		"db:seed": "pnpm --filter api prisma:seed",
		"test": "pnpm --filter @impostor/game test",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"packageManager": "pnpm@10.6.2",
	"devDependencies": {
		"prettier": "^3.10.1"
	}
}
